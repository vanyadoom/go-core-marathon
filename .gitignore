# ====================================================================
# АКАДЕМИЧЕСКИЙ СИСТЕМНЫЙ ФИЛЬТР МАРАФОНА (Go Core Git Hygiene)
# ====================================================================

# --- СКОМПИЛИРОВАННЫЕ БИНАРНИКИ ---
# Вырезаем исполняемые файлы, которые собирает команда go build.
# Файлу go.mod место на сервере, а скомпилированным бинарникам — строго на диске ПК.
main
main.exe
*.exe
*.exe~
*.dll
*.so
*.dylib
__debug_bin

# --- ВРЕМЕННЫЙ КЭШ И ТЕСТЫ ---
# Вырезаем результаты бенчмарков, тестов и профилирования памяти (pprof).
*.test
*.out
*.prof
cpu.pprof
mem.pprof

# --- СИСТЕМНЫЙ МУСОР VS CODE ---
# Вырезаем настройки локального редактора кода и скрытые файлы ОС Windows/Mac.
.vscode/
.idea/
.DS_Store
Thumbs.db
